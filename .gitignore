# NOTE: .gitignore does NOT support inline (end-of-line) comments — a '#' after a pattern
# becomes part of the pattern. Keep every comment on its own line.

# local RAG store & caches
db/
*.sqlite3
__pycache__/
*.pyc
.venv/
venv/
*.log
.DS_Store

# user's own config (keep config.example.yaml in git); may hold an API token
config.yaml

# audit log — engagement records, never commit
logs/

# fine-tuning + benchmark artifacts (regenerate locally; the committed RESULTS.md holds the numbers)
# LoRA adapter, merged model, GGUF exports (large)
eval/ft_out/
# generated outputs: results.csv, rag_metrics.json, project_stats.json, dashboard.html, *.png
eval/results/

# orchestrator runtime state
campaigns/
findings.db
